# Copy to /etc/skald/skald.env on the Pi. Owner: root:magnus, mode 0640.
ANTHROPIC_API_KEY=sk-ant-xxx
SKALD_MODEL=claude-haiku-4-5

# Location for weather (defaults to Stockholm if unset)
SKALD_LAT=59.3293
SKALD_LON=18.0686

# Optional: where to write state (default /var/lib/skald/state.json via systemd StateDirectory)
SKALD_STATE_PATH=/var/lib/skald/state.json

# Optional dev knob: when "1", force dry-run regardless of hardware presence.
# SKALD_FORCE_DRYRUN=1
