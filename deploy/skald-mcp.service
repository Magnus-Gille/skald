[Unit]
Description=Skald — e-paper MCP HTTP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=magnus
Group=magnus
WorkingDirectory=/home/magnus/repos/skald
ExecStart=/home/magnus/repos/skald/.venv/bin/python -m skald serve --host 0.0.0.0 --port 8765 --path /mcp
Restart=on-failure
RestartSec=5
StateDirectory=skald
StateDirectoryMode=0750

[Install]
WantedBy=multi-user.target
